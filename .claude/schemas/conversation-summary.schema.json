{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ConversationSummary",
  "description": "Claude Code 대화 세션의 구조화된 요약. 다음 세션이 컨텍스트를 빠르게 복원하고 작업을 이어가기 위한 스키마.",
  "type": "object",
  "required": ["meta", "objective", "state", "next_actions"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["session_id", "timestamp", "summary_version"],
      "properties": {
        "session_id": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "summary_version": { "type": "string", "default": "1.0" },
        "project": { "type": "string" },
        "branch": { "type": "string" },
        "commit": { "type": "string" },
        "total_turns": { "type": "integer" }
      }
    },

    "objective": {
      "type": "object",
      "description": "사용자가 궁극적으로 달성하려는 것",
      "required": ["primary_goal"],
      "properties": {
        "primary_goal": { "type": "string" },
        "sub_goals": { "type": "array", "items": { "type": "string" } },
        "success_criteria": { "type": "array", "items": { "type": "string" } },
        "constraints": {
          "type": "array",
          "description": "기술 스택, 스타일 가이드, 금지사항 등",
          "items": { "type": "string" }
        }
      }
    },

    "state": {
      "type": "object",
      "description": "현재 작업 상태의 스냅샷",
      "required": ["phase", "progress"],
      "properties": {
        "phase": {
          "type": "string",
          "enum": ["exploring", "designing", "implementing", "debugging", "testing", "refactoring", "reviewing", "blocked", "done"]
        },
        "progress": {
          "type": "object",
          "properties": {
            "completed": { "type": "array", "items": { "type": "string" } },
            "in_progress": { "type": "array", "items": { "type": "string" } },
            "pending": { "type": "array", "items": { "type": "string" } }
          }
        },
        "working_directory": { "type": "string" },
        "key_files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "role"],
            "properties": {
              "path": { "type": "string" },
              "role": {
                "type": "string",
                "description": "modified | created | referenced | target"
              },
              "summary": { "type": "string" },
              "last_state": {
                "type": "string",
                "description": "이 파일에 대한 마지막 변경 요약"
              }
            }
          }
        }
      }
    },

    "decisions": {
      "type": "array",
      "description": "대화 중 내린 주요 결정과 이유 (되돌아가지 않기 위해)",
      "items": {
        "type": "object",
        "required": ["decision", "rationale"],
        "properties": {
          "decision": { "type": "string" },
          "rationale": { "type": "string" },
          "alternatives_rejected": { "type": "array", "items": { "type": "string" } }
        }
      }
    },

    "issues": {
      "type": "array",
      "description": "발견된 문제, 에러, 블로커",
      "items": {
        "type": "object",
        "required": ["description", "status"],
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["open", "investigating", "workaround", "resolved", "blocked"]
          },
          "severity": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low"]
          },
          "location": { "type": "string", "description": "file:line 형식 권장" },
          "error_message": { "type": "string" },
          "attempted_fixes": { "type": "array", "items": { "type": "string" } },
          "hypothesis": { "type": "string" }
        }
      }
    },

    "context": {
      "type": "object",
      "description": "환경/도메인 지식. 다음 세션에서 재탐색 비용을 줄이기 위함",
      "properties": {
        "tech_stack": { "type": "array", "items": { "type": "string" } },
        "conventions": {
          "type": "array",
          "description": "코드 스타일, 네이밍, 패턴 등 발견된 규칙",
          "items": { "type": "string" }
        },
        "domain_knowledge": {
          "type": "array",
          "description": "프로젝트 특유의 용어, 비즈니스 로직 등",
          "items": {
            "type": "object",
            "properties": {
              "term": { "type": "string" },
              "meaning": { "type": "string" }
            }
          }
        },
        "external_dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "purpose": { "type": "string" },
              "version": { "type": "string" }
            }
          }
        }
      }
    },

    "artifacts": {
      "type": "object",
      "description": "참조용 코드/명령/결과",
      "properties": {
        "commands_run": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "command": { "type": "string" },
              "purpose": { "type": "string" },
              "outcome": { "type": "string" }
            }
          }
        },
        "snippets": {
          "type": "array",
          "description": "다시 찾기 번거로운 중요 코드 조각",
          "items": {
            "type": "object",
            "properties": {
              "description": { "type": "string" },
              "language": { "type": "string" },
              "code": { "type": "string" },
              "source_file": { "type": "string" }
            }
          }
        },
        "test_results": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "status": { "type": "string", "enum": ["pass", "fail", "skip"] },
              "detail": { "type": "string" }
            }
          }
        }
      }
    },

    "next_actions": {
      "type": "array",
      "description": "다음 세션에서 바로 시작할 수 있도록 구체적으로",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["action", "priority"],
        "properties": {
          "action": { "type": "string", "description": "구체적이고 실행 가능하게" },
          "priority": { "type": "string", "enum": ["must", "should", "could"] },
          "entry_point": {
            "type": "string",
            "description": "어느 파일/함수부터 시작할지"
          },
          "depends_on": { "type": "array", "items": { "type": "string" } },
          "estimated_complexity": { "type": "string", "enum": ["trivial", "small", "medium", "large"] }
        }
      }
    },

    "open_questions": {
      "type": "array",
      "description": "사용자에게 확인이 필요한 사항",
      "items": { "type": "string" }
    },

    "user_preferences": {
      "type": "object",
      "description": "대화에서 드러난 사용자의 선호",
      "properties": {
        "language": { "type": "string", "description": "응답 언어 (예: ko)" },
        "style": { "type": "array", "items": { "type": "string" } },
        "avoid": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
